{
  "servers": {
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.11.25", "/home/robne/projects/active"],
      "env": {
        "ALLOWED_DIRECTORIES": "/home/robne/projects/active"
      }
    },
    "sqlite-tanium": {
      "command": "/home/robne/projects/active/tanium-tco/modern-tco/docker/mcp-sqlite-tanium/docker-mcp-wrapper.sh",
      "args": [
        "--db-path",
        "/data/db/tanium_tco.db"
      ],
      "env": {
        "SQLITE_DATABASE_PATH": "/data/db/tanium_tco.db"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@2025.4.8"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@3.6.2"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.49"],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "/home/robne/.cache/ms-playwright",
        "PLAYWRIGHT_CHROMIUM_USE_HEADLESS_NEW": "1",
        "DISPLAY": ":0",
        "NODE_OPTIONS": "--max-old-space-size=4096",
        "PLAYWRIGHT_SKIP_BROWSER_GC": "1"
      }
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-postgrest@latest",
        "--apiUrl",
        "https://qnwcwoutgarhqxlgsjzs.supabase.co/rest/v1",
        "--apiKey",
        "${SUPABASE_ANON_KEY}",
        "--schema",
        "public"
      ]
    },
    "vibe-check": {
      "command": "npx",
      "args": ["-y", "@pv-bhat/vibe-check-mcp@2.7.6"]
    },
    "docker": {
      "command": "uvx",
      "args": ["docker-mcp"]
    },
    "archon": {
      "type": "http",
      "url": "http://localhost:8051/mcp"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@1.0.31"]
    }
  }
}
