ons?.ttl || this.defaultTTL;\n    const size = options?.size || this.estimateSize(value);\n\n    // Check if we need to evict items\n    if (this.cache.size >= this.maxSize) {\n      this.evictLRU();\n    }\n\n    const entry: CacheEntry<unknown",[2327,2329],[2378,2380],[5782,5784],[8367,8369],[8434,8436],[8460,8462],[4318,4393],"executePlan(query: QueryNode, _plan: QueryPlan): QueryResult",[9656,9658],[11173,11175],[14919,14921],[14977,14979],[15039,15041],[15081,15083],[15126,15128],[15200,15202],[8522,8524],[1382,1384],[5678,5680],[27466,27468],[29516,29518],[29611,29613],[409,411],[1539,1541],[587,1008],"(obj: any): unknown {\n  if (obj === null || obj === undefined) {\n    return obj;\n  }\n\n  if (Array.isArray(obj)) {\n    return obj.map((item) => camelCaseKeys(item)) as unknown;\n  }\n\n  if (typeof obj === 'object' && obj.constructor === Object) {\n    return Object.keys(obj).reduce((acc, key) => {\n      const camelKey = snakeToCamel(key);\n      acc[camelKey] = camelCaseKeys(obj[key]);\n      return acc;\n    }, {} as any) as unknown",[1144,1565],"(obj: any): unknown {\n  if (obj === null || obj === undefined) {\n    return obj;\n  }\n\n  if (Array.isArray(obj)) {\n    return obj.map((item) => snakeCaseKeys(item)) as unknown;\n  }\n\n  if (typeof obj === 'object' && obj.constructor === Object) {\n    return Object.keys(obj).reduce((acc, key) => {\n      const snakeKey = camelToSnake(key);\n      acc[snakeKey] = snakeCaseKeys(obj[key]);\n      return acc;\n    }, {} as any) as unknown",[4335,4337],[6087,6206],"validateCriterion(\n    criterion: ValidationCriteria,\n    context: ValidationContext\n  ): CriteriaResult",[9413,9415],[9578,9580],[13533,13535],[17539,17541],[20901,20903],[20918,20920],[21185,21187],[21233,21235],[21290,21292],[21337,21339],[21470,21472],[21527,21529],[21578,21580],[21616,21618],[21716,21718],[21767,21769],[21815,21817],[21862,21864],[22637,22639],[23007,23063],[4100,4102],[4376,4378],[9211,9213],[9229,9404],"byModule[module] ??=