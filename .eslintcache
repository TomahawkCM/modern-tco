 } else {\n          setData((initialData ?? []) as unknown as unknown[]);\n        }\n\n        // Set up real-time subscription\n        subscription = supabase\n          .channel(`${table}_changes`)\n          .on(\n            'postgres_changes',\n            {\n              event: '*',\n              schema: 'public',\n              table: table as string,\n              filter,\n            },\n            (payload) => {\n              if (callback) {\n                callback(payload);\n              }\n\n              // Update local data based on event type\n              setData((current) => {\n                switch (payload.eventType) {\n                  case 'INSERT':\n                    return [...current, payload.new as unknown as unknown];\n                  case 'UPDATE':\n                    return current.map((item) =>\n                      (item as any).id === (payload.new as any).id\n                        ? (payload.new as unknown as unknown",[2218,2220],[11493,11495],[11741,11743],[4102,4104],[4213,4215],[4287,4289],[4380,4382],[4445,4447],[7532,7534],[7538,7540],[7821,7823],[7831,7833],[8440,8442],[10751,10753],[11084,11086],[13674,13676],[13739,13741],[13773,13775],[15125,15127],[15225,15227],[15942,15944],[8826,8828],[13844,13846],[6028,6104],"cohort ??= await calculateGlobalCohortBenchmarks();",[9489,9491],[10501,10503],[10517,10519],[3148,3150],[3382,3384],[7126,7128],[7142,7144],[14200,14307],"prediction ??= await predictTimeToMastery(userId, domain, targetMasteryLevel);",[3731,3733],[3737,3739],[4233,4235],[4239,4241],[4552,4554],[6010,6012],[6283,6285],[3591,3593],[4241,4243],[6666,6668],[6725,6727],[10221,10223],[10237,10239],[10304,10306],[10318,10320],[10389,10391],[10407,10409],[10478,10480],[10497,10499],[4465,4467],[4471,4473],[5041,5043],[6915,7028],"function generateInterventionRecommendations(\n  context: RecommendationContext\n): Recommendation[]",[13919,13921],[14531,14642],"function generateWeakDomainRecommendations(\