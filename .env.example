# ============================================================================
# Environment Variables Template - Modern Tanium TCO Learning Management System
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control (it's in .gitignore)
#
# Quick Start:
#   1. Copy: cp .env.example .env.local (Unix) or Copy-Item .env.example .env.local (PowerShell)
#   2. Fill in values below (at minimum: Supabase credentials)
#   3. Restart dev server: npm run dev
# ============================================================================

# ----------------------------------------------------------------------------
# Database (Supabase PostgreSQL) - REQUIRED
# ----------------------------------------------------------------------------

# Public Supabase URL (safe to expose in client-side code)
# Get from: Supabase Dashboard → Settings → API → Project URL
# Example: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Supabase Anonymous Key (public, safe for client-side)
# Get from: Supabase Dashboard → Settings → API → Project API keys → anon public
# This key has Row Level Security (RLS) restrictions
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (SECRET - server-side only!)
# Get from: Supabase Dashboard → Settings → API → Project API keys → service_role
# WARNING: This bypasses RLS - NEVER expose to client-side code
# Used for: Server-side operations, database migrations, admin tasks
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase Access Token (for CLI and MCP server operations - optional)
# Get from: Supabase Dashboard → Settings → Access Tokens
# Used for: Supabase CLI commands, MCP server integration
SUPABASE_ACCESS_TOKEN=your_supabase_access_token

# Direct Database Connection URL (optional - for direct PostgreSQL access)
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Get from: Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.your_ref:your_password@aws-0-region.pooler.supabase.com:5432/postgres

# Local Supabase (if running `supabase start` locally - optional)
SUPABASE_LOCAL_URL=http://localhost:54321
SUPABASE_LOCAL_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0


# ----------------------------------------------------------------------------
# AI Services (Optional but recommended)
# ----------------------------------------------------------------------------

# Anthropic Claude API Key (for AI flashcard generation, smart recommendations)
# Get from: https://console.anthropic.com/settings/keys
# Used for: /api/flashcards/generate, adaptive learning paths, AI tutor
# Cost: ~$0.01-0.05 per flashcard generation
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI API Key (fallback if Anthropic unavailable)
# Get from: https://platform.openai.com/api-keys
# Used for: Fallback AI generation when ANTHROPIC_API_KEY not set
OPENAI_API_KEY=your_openai_api_key

# OpenAI API Key for Budget App AI Features (client-side accessible)
# Get from: https://platform.openai.com/api-keys
# Used for: Budget app AI features (smart duplicate detection, anomaly detection,
#           predictive spending, natural language import)
# Model: gpt-4o-mini (fast and cost-effective)
# Privacy: Only sends cleaned transaction descriptions (no sensitive data)
# Cost: ~$0.0001-0.0005 per API call
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key


# ----------------------------------------------------------------------------
# Payment Processing (Stripe) - Optional (only if using paid features)
# ----------------------------------------------------------------------------

# Stripe Secret Key (SECRET - server-side only!)
# Get from: https://dashboard.stripe.com/apikeys
# Used for: Payment processing, subscription management
STRIPE_SECRET_KEY=your_stripe_secret_key

# Stripe Webhook Secret (for webhook signature verification)
# Get from: https://dashboard.stripe.com/webhooks
# Used for: Verifying Stripe webhook events (payment confirmations, etc.)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Stripe Price IDs (Product pricing configuration)
# Get from: Stripe Dashboard → Products → Copy Price ID
STRIPE_PRICE_FREE=price_xxx_free_tier
STRIPE_PRICE_PRO=price_xxx_pro_tier
STRIPE_PRICE_TEAM=price_xxx_team_tier


# ----------------------------------------------------------------------------
# Analytics & Monitoring (Optional)
# ----------------------------------------------------------------------------

# PostHog Analytics Key (for user behavior tracking)
# Get from: https://app.posthog.com/project/settings
# Used for: Feature usage analytics, user journey tracking, A/B testing
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key

# PostHog Host (usually PostHog Cloud)
# Default: https://app.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry DSN (for error tracking - optional)
# Get from: https://sentry.io/settings/projects/
# Used for: Production error monitoring and alerting
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn


# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------

# Admin Email Addresses (comma-separated)
# Users with these emails get admin access
# Example: admin@example.com,superadmin@company.com
NEXT_PUBLIC_ADMIN_EMAILS=your_admin_email@example.com

# Team Seat Limit (max users per team subscription)
# Default: 10
NEXT_PUBLIC_TEAM_SEAT_LIMIT=10

# Environment Name (development, staging, production)
# Used for: Feature flags, debugging, conditional behavior
NEXT_PUBLIC_ENV=development

# Node Environment (automatically set by framework)
# Values: development, production, test
NODE_ENV=development

# TCO Application Version
TCO_APP_VERSION=1.0.0

# TCO Certification Configuration
TCO_CERTIFICATION_DOMAINS=5
TCO_EXAM_TIME_LIMIT=105


# ----------------------------------------------------------------------------
# Feature Flags & Experimental Features
# ----------------------------------------------------------------------------

# Enable experimental learning features
# Set to "1" to enable, leave blank to disable
# Enables: Experimental module page with enhanced UI
NEXT_PUBLIC_LEARN_EXPERIMENTAL=

# Enable analytics debug mode (verbose console logging)
# Set to "true" to see detailed analytics events in console
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Enable test hooks for E2E testing
# Set to "true" when running Playwright/Cypress tests
NEXT_PUBLIC_TEST_HOOKS=false

# Enable Tanium Simulator endpoints in production
# Set to "true" to allow simulator API routes on Vercel
# WARNING: Simulator uses Python subprocess - may not work on serverless
ENABLE_SIMULATOR=false

# Base path for Next.js application (if deployed to subdirectory)
# Example: /tco-app
# Leave blank for root deployment
NEXT_PUBLIC_BASE_PATH=


# ----------------------------------------------------------------------------
# Development Tools (Optional)
# ----------------------------------------------------------------------------

# Python Path for Tanium Simulator (local development only)
# Only needed if using /simulator page
# Example: /usr/bin/python3 or C:\\Python39\\python.exe
PYTHON_PATH=/usr/bin/python3

# Simulator Python Script Path (usually auto-detected)
# Only override if script location is non-standard
SIM_PYTHON=

# Error Log File Path (for server-side error logging)
# Default: ./logs/errors.log
ERROR_LOG_FILE=./logs/errors.log


# ----------------------------------------------------------------------------
# Static User ID (Development/Testing Only)
# ----------------------------------------------------------------------------

# Static User ID for flashcard testing without authentication
# Only used in development when Supabase auth is not configured
# Example: 12345678-1234-1234-1234-123456789012
NEXT_PUBLIC_FLASHCARD_STATIC_USER_ID=
FLASHCARD_STATIC_USER_ID=


# ----------------------------------------------------------------------------
# Platform Detection (Automatically set - do not modify)
# ----------------------------------------------------------------------------

# Vercel deployment detection (automatically set by Vercel)
VERCEL=


# ============================================================================
# END OF CONFIGURATION
# ============================================================================
#
# Required for Basic Functionality:
#   ✓ NEXT_PUBLIC_SUPABASE_URL
#   ✓ NEXT_PUBLIC_SUPABASE_ANON_KEY
#   ✓ SUPABASE_SERVICE_ROLE_KEY
#
# Recommended for Full Features:
#   ○ ANTHROPIC_API_KEY (for AI flashcard generation)
#   ○ NEXT_PUBLIC_OPENAI_API_KEY (for budget app AI features)
#   ○ NEXT_PUBLIC_POSTHOG_KEY (for analytics)
#   ○ NEXT_PUBLIC_ADMIN_EMAILS (for admin access)
#
# Optional for Premium Features:
#   ○ STRIPE_SECRET_KEY (for payments)
#   ○ STRIPE_WEBHOOK_SECRET (for webhook verification)
#   ○ STRIPE_PRICE_* (for pricing tiers)
#
# Next Steps:
#   1. Fill in Supabase credentials (required)
#   2. Add at least one admin email address
#   3. (Optional) Add ANTHROPIC_API_KEY for AI flashcard generation
#   4. (Optional) Add NEXT_PUBLIC_OPENAI_API_KEY for budget app AI features
#   5. (Optional) Configure analytics with PostHog
#   6. Restart dev server: npm run dev
#
# Documentation:
#   - Supabase Setup: docs/POSTGRESQL_SCHEMA_SETUP.md
#   - Deployment Guide: docs/DEPLOYMENT.md
#   - Database Schema: supabase/migrations/
#
# Security Reminders:
#   ⚠️  NEVER commit .env.local to Git (already in .gitignore)
#   ⚠️  Keep SUPABASE_SERVICE_ROLE_KEY and STRIPE_SECRET_KEY secret
#   ⚠️  Rotate keys immediately if accidentally exposed
#   ⚠️  Use different keys for development/staging/production environments
#   ⚠️  Enable 2FA on all service accounts (Supabase, Stripe, etc.)
# ============================================================================
